<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ubicación -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Antirrobo -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Correr sin límites de batería: clave para sobrevivir con la app cerrada -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Auto-actualización: instalar la APK nueva -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".CentinelaApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:theme="@style/Theme.Centinela">

        <!-- Ícono SIEMPRE visible en el launcher: no hay modo oculto (política Play). -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.OnboardingActivity" android:exported="false" />

        <!-- Checklist de configuración (permisos, batería, admin…) -->
        <activity android:name=".ui.SetupActivity" android:exported="false" />

        <!-- Provisión por QR como Device Owner (Android 10+ exige responder estos intents) -->
        <activity
            android:name=".provisioning.ProvisioningActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Pantalla de PIN: bloqueo al abrir, setup del PIN maestro y verificación. -->
        <activity
            android:name=".ui.PinActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity android:name=".ui.LinkAccountActivity" android:exported="false" />

        <!-- Pantalla de "teléfono perdido", se muestra sobre el bloqueo. -->
        <activity
            android:name=".ui.LostMessageActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <!-- Device Admin -->
        <receiver
            android:name=".admin.CentinelaDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Push FCM: transporte de comandos remotos -->
        <service
            android:name=".fcm.CentinelaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Servicio guardián: escucha comandos (app cerrada) + rastreo. Notificación persistente. -->
        <service
            android:name=".service.GuardianService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Captura de foto del intruso (FGS tipo cámara: cámara en segundo plano) -->
        <service
            android:name=".commands.CaptureService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- (Legado) Servicio de rastreo anterior, ya no se usa. -->
        <service
            android:name=".location.LocationService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Reprograma vigilancia + guarda SIM tras reinicio o actualización de la app -->
        <receiver
            android:name=".sim.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Watchdog: revive el servicio guardián periódicamente si el sistema lo mató -->
        <receiver
            android:name=".service.WatchdogReceiver"
            android:exported="false" />

        <!-- Estado de la auto-actualización (PackageInstaller) -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Recepción de geocercas -->
        <receiver
            android:name=".geofence.GeofenceBroadcastReceiver"
            android:exported="false" />

    </application>
</manifest>
