<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Estado -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="@drawable/bg_card"
            android:text="@string/status_protected"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSetup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Estado de configuración"
            android:textColor="@color/text"
            android:background="@drawable/bg_card" />

        <Button
            android:id="@+id/btnAllowUninstall"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="Permitir desinstalar la app"
            android:textColor="@color/danger"
            android:background="@drawable/bg_card" />

        <!-- Cuenta / portal -->
        <TextView style="@style/SectionLabel" android:text="@string/section_portal" />

        <TextView
            android:id="@+id/accountStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/account_not_linked"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnLink"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_link"
            android:textColor="@color/text"
            android:background="@drawable/bg_card" />

        <!-- Toggles -->
        <TextView style="@style/SectionLabel" android:text="@string/section_features" />

        <LinearLayout style="@style/CardRow">
            <LinearLayout style="@style/RowText">
                <TextView style="@style/RowTitle" android:text="@string/feature_antitheft_photo" />
                <TextView style="@style/RowSubtitle" android:text="@string/feature_antitheft_photo_sub" />
            </LinearLayout>
            <Switch android:id="@+id/switchPhoto"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/CardRow">
            <LinearLayout style="@style/RowText">
                <TextView style="@style/RowTitle" android:text="@string/feature_family" />
                <TextView style="@style/RowSubtitle" android:text="@string/feature_family_sub" />
            </LinearLayout>
            <Switch android:id="@+id/switchTracking"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Device admin -->
        <TextView style="@style/SectionLabel" android:text="@string/section_protection" />

        <Button
            android:id="@+id/btnDeviceAdmin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/enable_device_admin"
            android:textColor="@color/text"
            android:background="@drawable/bg_card" />

        <!-- SOS -->
        <Button
            android:id="@+id/btnSos"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="28dp"
            android:text="@string/sos_button"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_danger" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/sos_hint"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
